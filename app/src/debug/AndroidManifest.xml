<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Safe sideload test build: do not advertise privileged services.
         The release manifest retains them for an explicitly consented
         distribution flow. -->
    <application>
        <service
            android:name="com.galaxyrio.gracelauncher.platform.GraceAccessibilityService"
            tools:node="remove" />

        <service
            android:name="com.galaxyrio.gracelauncher.data.media.MediaNotificationListener"
            tools:node="remove" />
    </application>
</manifest>
